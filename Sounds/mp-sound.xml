<?xml version="1.0"?>
<!--
	thanks to the SAR simulation (GPL) for the helicopter Aircraft/Bell_412/Sounds,
	and the Urban game (LGPL) for the weapon Aircraft/Bell_412/Sounds

	+x = aft
	+y = left
	+z = up
-->

<PropertyList>
	<fx>
	<ambience_outside>
			<name>ambience-outside</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/ambience_outside.wav</path>
			<condition>
				<not>
					<property>sim/current-view/internal</property>
				</not>
			</condition>
			<volume>
				<factor>0.5</factor>
			</volume>
		</ambience_outside>
		
		 <starter>
			<name>starter0_start</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/startup_exterior_short.wav</path>
			<condition>
				<property>engines/engine[0]/running</property>
			</condition>
			<volume>
				<factor>0.7</factor>
			</volume>
			<volume>
				<property>/sound/view-level-outside</property>
			</volume>
		</starter>
   
     <starter>
			<name>starter1_start</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/startup_exterior_short.wav</path>
			<condition>
				<property>engines/engine[1]/running</property>
			</condition>
			<volume>
				<factor>0.7</factor>
			</volume>
			<volume>
				<property>/sound/view-level-outside</property>
			</volume>
		</starter>
		
		<rotor>
			<name>rotor-outside</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/outside_noflap.wav</path>
			<condition>
				<and>
					<not>
						<property>sim/current-view/internal</property>
					</not>
					<greater-than>
						<property>rotors/main/rpm</property>
						<value>50</value>
					</greater-than>
					<not>
						<property>sim/crashed</property>
					</not>
				</and>
			</condition>
			<volume>
				<property>rotors/main/rpm</property>
				<factor>0.002</factor>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.002262</factor>
				<offset>0</offset>
				<min>0</min>
				<max>1.5</max>
			</pitch>
			<reference-dist>100</reference-dist>
			<max-dist>1000</max-dist>
		</rotor>
	
   
    
    <rotor>
      <name>tail_rotor</name>
      <mode>looped</mode>
      <path>Aircraft/Bell_412/Sounds/tailrotor.wav</path>
      <condition>
                <and>
                    <greater-than>
                        <property>rotors/main/rpm</property>
                        <value>50</value>
                    </greater-than>
                    <not>
                        <property>sim/crashed</property>
                    </not>
			<not>
			<property>sim/current-view/internal</property>
			</not>
                </and>
            </condition>
            <volume>
                <factor>0.8</factor>
            </volume>
            <pitch>
                <property>rotors/tail/rpm</property>
                <factor>0.0006</factor>
                <offset>-0.0</offset>
                <max>2.5</max>
            </pitch>
            <position>
                <x> -2 </x>
                <y> -0.4 </y>
                <z> 1.3 </z>
            </position>
            <orientation>
                <x> 1 </x>
                <y> . </y>
                <z> 0 </z>
                <inner-angle>110</inner-angle>
                <outer-angle>220</outer-angle>
                <outer-gain>0.1</outer-gain>
            </orientation>
            <reference-dist>500</reference-dist>
            <max-dist>5000</max-dist>
    </rotor>
    
	  <crash>
      <name>intense ground contact</name>
      <mode>once</mode>
      <path>Sounds/crash.wav</path>
      <property>sim/crashed</property>
      <volume>
        <factor>1</factor>
      </volume>
      <pitch>
        <factor>0.1</factor>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>1000</max-dist>
    </crash>
	
	<fire>
      <name>Fire</name>
      <mode>looped</mode>
      <path>Aircraft/Bell_412/Sounds/Fire.wav</path>
     <condition>
<equals>
<property>sim/multiplay/generic/int[7]</property>
<value type="bool">true</value>
</equals>
</condition>
      <volume>
        <value>1</value>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>4000</max-dist>
    </fire>	

		
	</fx>
</PropertyList>
