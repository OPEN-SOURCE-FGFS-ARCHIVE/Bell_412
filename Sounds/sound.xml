<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>
  
  <fx>
  	<avionics>
			<name>avionics1</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/avionics_1.wav</path>
			<condition>
				<property>sim/current-view/internal</property>
			</condition>
			<volume>
				<factor>0.01</factor>
			</volume>
			<position>
				<x>-1</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>1</reference-dist>
			<max-dist>3</max-dist>
		</avionics>

		<avionics>
			<name>avionics2</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/avionics_2.wav</path>
			<condition>
				<property>sim/current-view/internal</property>
			</condition>
			<volume>
				<factor>0.014</factor>
			</volume>
			<position>
				<x>-1</x>
				<y>-0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>1</reference-dist>
			<max-dist>3</max-dist>
		</avionics>

		<avionics>
			<name>avionics3</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/avionics_3.wav</path>
			<condition>
				<property>sim/current-view/internal</property>
			</condition>
			<volume>
				<factor>0.013</factor>
			</volume>
			<position>
				<x>0</x>
				<y>0</y>
				<z>0</z>
			</position>
			<reference-dist>1</reference-dist>
			<max-dist>3</max-dist>
		</avionics>


		<ambience_outside>
			<name>ambience-outside</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/ambience_outside.wav</path>
			<condition>
				<not>
					<property>sim/current-view/internal</property>
				</not>
			</condition>
			<volume>
				<factor>0.5</factor>
			</volume>
		</ambience_outside>

		<ambience_outside_inside>
			<name>ambience-outside-inside-r</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/ambience_outside.wav</path>
			<condition>
				<property>sim/current-view/internal</property>
			</condition>
			<volume>
				<property>sound/outside-sound-lvl-doors-R</property>
				<factor>0.6</factor>
			</volume>
			<position>
				<x>-2</x>
				<y>-2</y>
				<z>0</z>
			</position>
		</ambience_outside_inside>

		<ambience_outside_inside>
			<name>ambience-outside-inside-l</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/ambience_outside.wav</path>
			<condition>
				<property>sim/current-view/internal</property>
			</condition>
			<volume>
				<property>sound/outside-sound-lvl-doors-L</property>
				<factor>0.6</factor>
			</volume>
			<position>
				<x>-2</x>
				<y>2</y>
				<z>0</z>
			</position>
		</ambience_outside_inside>
  
  
    <starter>
			<name>starter0_start</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/startup_exterior_short.wav</path>
			<condition>
				<property>engines/engine[0]/running</property>
			</condition>
			<volume>
				<factor>0.7</factor>
			</volume>
			<volume>
				<property>/sound/view-level-outside</property>
			</volume>
		</starter>
   
     <starter>
			<name>starter1_start</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/startup_exterior_short.wav</path>
			<condition>
				<property>engines/engine[1]/running</property>
			</condition>
			<volume>
				<factor>0.7</factor>
			</volume>
			<volume>
				<property>/sound/view-level-outside</property>
			</volume>
		</starter>
   
   
   <starter>
			<name>starter0_start-inside</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/startup_interior_short.wav</path>
			<condition>
				<property>engines/engine[0]/running</property>
			</condition>
			<volume>
				<factor>1</factor>
			</volume>
			<volume>
				<property>/sound/view-level-inside</property>
			</volume>
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
		</starter>
    
    <!-- outside -->
    <!-- rotor -->
	<rotor>
			<name>rotor-outside</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/outside_noflap.wav</path>
			<condition>
				<and>
					<not>
						<property>sim/current-view/internal</property>
					</not>
					<greater-than>
						<property>rotors/main/rpm</property>
						<value>50</value>
					</greater-than>
					<not>
						<property>sim/crashed</property>
					</not>
				</and>
			</condition>
			<volume>
				<property>rotors/main/rpm</property>
				<factor>0.002</factor>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.002262</factor>
				<offset>0</offset>
				<min>0</min>
				<max>1.5</max>
			</pitch>
			<reference-dist>100</reference-dist>
			<max-dist>1000</max-dist>
		</rotor>
	
   
    
    <rotor>
      <name>tail_rotor</name>
      <mode>looped</mode>
      <path>Aircraft/Bell_412/Sounds/tailrotor.wav</path>
      <condition>
                <and>
                    <greater-than>
                        <property>rotors/main/rpm</property>
                        <value>50</value>
                    </greater-than>
                    <not>
                        <property>sim/crashed</property>
                    </not>
			<not>
			<property>sim/current-view/internal</property>
			</not>
                </and>
            </condition>
            <volume>
                <factor>0.8</factor>
            </volume>
            <pitch>
                <property>rotors/tail/rpm</property>
                <factor>0.0006</factor>
                <offset>-0.0</offset>
                <max>2.5</max>
            </pitch>
            <position>
                <x> -2 </x>
                <y> -0.4 </y>
                <z> 1.3 </z>
            </position>
            <orientation>
                <x> 1 </x>
                <y> . </y>
                <z> 0 </z>
                <inner-angle>110</inner-angle>
                <outer-angle>220</outer-angle>
                <outer-gain>0.1</outer-gain>
            </orientation>
            <reference-dist>500</reference-dist>
            <max-dist>5000</max-dist>
    </rotor>
    
    
	<rotor>
			<name>rotor-inside</name>
			<mode>looped</mode>
			 <path>Aircraft/Bell_412/Sounds/fguk/inside_loop_mono.wav</path>
			<condition>
				<and>
					<property>sim/current-view/internal</property>
					<greater-than>
						<property>rotors/main/rpm</property>
						<value>50</value>
					</greater-than>
					<not>
						<property>sim/crashed</property>
					</not>
				</and>
			</condition>
			<volume>
				<factor>1</factor>
			</volume>
			<volume>
				<property>rotors/main/rpm</property>
				<factor>0.002</factor>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.002262</factor>
				<offset>0</offset>
				<min>0</min>
				<max>1.5</max>
			</pitch>
			<reference-dist>100</reference-dist>
			<max-dist>1000</max-dist>
		</rotor>
	
  
    
    <rotor>
      <name>stall</name>
      <mode>looped</mode>
      <path>Aircraft/Bell_412/Sounds/fguk/blade_vortex_interior.wav</path>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <not>
            <property>sim/crashed</property>
          </not>
        </and>
      </condition>
      <volume>
        <property>rotors/main/stall-filtered</property>
        <factor>160</factor>
        <max>1.6</max>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.00325</factor>
        <offset>0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>5000</max-dist>
    </rotor>
	
		<rotor>
			<name>blade-vortex-interaction-G-inside</name>
			<mode>looped</mode>
			 <path>Aircraft/Bell_412/Sounds/fguk/blade_vortex_interior.wav</path>
			<condition>
           <and>
				<greater-than>
					<property>sim/multiplay/generic/float[15]</property>
					<value>1.4</value>
				</greater-than>
				 
			<property>sim/current-view/internal</property>
		    
				
			</and>	
						
			</condition>
			<volume>
				<property>accelerations/pilot-g</property>
				<factor>0.0001</factor>
    	<offset>0.25</offset>
	<min>0.0</min>
	<max>1.0</max>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.003262</factor>
				<offset>0</offset>
				<min>0.</min>
				<max>1.5</max>
			</pitch>
			
			<max-dist>30</max-dist>
		</rotor>

   
    <contact>
      <name>ground contact</name>
      <mode>once</mode>
      <path>Aircraft/Bell_412/Sounds/TC1.wav</path>
      <condition>
        <property>gear/gear[0]/wow</property>
        <property>gear/gear[1]/wow</property>
        <property>gear/gear[2]/wow</property>
        <property>gear/gear[3]/wow</property>
      </condition>
      <volume>
        <factor>0.8</factor>
      </volume>
      <pitch>
        <factor>0.01</factor>
      </pitch>
      <reference-dist>5.0</reference-dist>
      <max-dist>10.0</max-dist>
    </contact>
    
    <wind>
      <name>wind</name>
      <mode>looped</mode>
      <path>Sounds/wind.wav</path>
      <condition>
        <and>
          <property>velocities/airspeed-kt</property>
          <not>
            <property>sim/crashed</property>
          </not>
        </and>
      </condition>
      <volume>
        <property>velocities/airspeed-kt</property>
        <factor>0.0015</factor>
        <min>0.00</min>
        <max>0.25</max>
      </volume>
      <volume>
        <property>sim/model/bo105/sound/volume_level</property>
        <factor>1.00</factor>
        <min>0.00</min>
        <max>1.00</max>
      </volume>     
      <pitch>
        <property>velocities/airspeed-kt</property>
        <factor>0.01</factor>
        <offset>1.25</offset>
      </pitch>
      <reference-dist>10.0</reference-dist>
      <max-dist>20.0</max-dist>
    </wind>
    
    <crash>
      <name>intense ground contact</name>
      <mode>once</mode>
      <path>Sounds/crash.wav</path>
      <property>sim/crashed</property>
      <volume>
        <factor>1</factor>
      </volume>
      <pitch>
        <factor>0.1</factor>
      </pitch>
      <reference-dist>500</reference-dist>
      <max-dist>1000</max-dist>
    </crash>
    
 
	
	<floats>
			<name>floats</name>
			<mode>once</mode>
			<path>Aircraft/Bell_412/Sounds/inflate.wav</path>
			<condition>
			<equals>
				 <property>controls/gear/floats-inflat</property>
				<value>true</value>
				</equals>
			
				
			</condition>
			<volume>
				<factor>0.5</factor>
			</volume>
			<position>
				<x>-0.88</x>
				<y>0.40</y>
				<z>0.5</z>
			</position>
			<reference-dist>5</reference-dist>
			<max-dist>10</max-dist>
		</floats>
		


		<rotor>
			<name>blade-vortex-interaction</name>
			<mode>looped</mode>
			<path>Aircraft/Bell_412/Sounds/fguk/blade_vortex_interior.wav</path>
			<condition>
				<and>
					<property>sim/current-view/internal</property>
					<greater-than>
						<property>sim/sound/vibration</property>
						<value>0.01</value>
					</greater-than>
				</and>
			</condition>
			<volume>
				<property>sim/sound/vibration</property>
			</volume>
			<pitch>
				<property>rotors/main/rpm</property>
				<factor>0.002262</factor>
				<offset>0</offset>
				<min>0</min>
				<max>1.5</max>
			</pitch>
			<reference-dist>1000</reference-dist>
			<max-dist>3000</max-dist>
		</rotor>
		
		<fire>
      <name>Fire</name>
      <mode>looped</mode>
      <path>Aircraft/Bell_412/Sounds/Fire.wav</path>
     <condition>
<equals>
<property>sim/multiplay/generic/int[7]</property>
<value type="bool">true</value>
</equals>
</condition>
      <volume>
        <value>1</value>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>4000</max-dist>
    </fire>	
	
