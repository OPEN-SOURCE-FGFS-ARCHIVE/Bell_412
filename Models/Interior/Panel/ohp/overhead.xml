<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

<path>overhead.ac</path>

<animation>
  <type>range</type>
  <min-m>0</min-m>
  <max-m>20</max-m>
 </animation>
 
 
  <animation>
    <type>material</type>
    <object-name>potipilot</object-name>
    <object-name>potiengine</object-name>
	<object-name>potiped</object-name>
	<object-name>poticopilot</object-name>
    <object-name>potisec</object-name>
	<object-name>poticonsole</object-name>
	 <object-name>wip-pilot</object-name>
	<object-name>wip-copilot</object-name>
	<object-name>aft-dome-lt</object-name>
    <emission>
			<red>0.28</red>
			<green>0.40</green>
			<blue>0.24</blue>
<factor-prop>controls/lighting/engine-lights-norm</factor-prop>
		</emission>
  </animation>
  
  
  <animation>
    <type>material</type>
    <object-name>object.050</object-name>
   
    <emission>
			<red>0.08</red>
			<green>0.10</green>
			<blue>0.04</blue>
<factor-prop>controls/lighting/engine-lights-norm</factor-prop>
		</emission>
  </animation>
 
 
 
 
 <model>
 <name>rotor brake</name>
 <path>Aircraft/Bell_412/Models/Interior/Panel/Instruments/clutch_lever/clutch_lever.xml</path>
 <offsets>
 <x-m>-1.635</x-m>
 <y-m>0.2</y-m>
 <z-m>2.29</z-m>
 <pitch-deg>90</pitch-deg>
 </offsets>
 
 </model>
 
 
 <!-- knobs -->
 
<!-- pilot -->
  <animation>
    <type>knob</type>
    <object-name>potipilot</object-name>
    <property>controls/lighting/instrument-lights-norm</property>
    <center>
      <x-m> -1.705</x-m>
      <y-m> 0.13</y-m>
      <z-m> 2.215</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
    <factor>30</factor>
    <action>
      <binding>
        <command>property-adjust</command>
        <property>controls/lighting/instrument-lights-norm</property>
        <min>0</min>
        <max>10</max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>
  
  <!-- engine -->
  <animation>
    <type>knob</type>
    <object-name>potiengine</object-name>
    <property>controls/lighting/engine-lights-norm</property>
    <center>
      <x-m> -1.705</x-m>
      <y-m> 0.09</y-m>
      <z-m> 2.215</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
    <factor>30</factor>
    <action>
      <binding>
        <command>property-adjust</command>
        <property>controls/lighting/engine-lights-norm</property>
        <min>0</min>
        <max>10</max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>
  
   <!-- centre console -->
  <animation>
    <type>knob</type>
    <object-name>potiped</object-name>
    <property>controls/lighting/ped-lights-norm</property>
    <center>
      <x-m> -1.651</x-m>
      <y-m> 0.09</y-m>
      <z-m> 2.215</z-m>
    </center>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
    <factor>30</factor>
    <action>
      <binding>
        <command>property-adjust</command>
        <property>controls/lighting/ped-lights-norm</property>
        <min>0</min>
        <max>10</max>
        <wrap>false</wrap>
      </binding>
    </action>
  </animation>
 
 
