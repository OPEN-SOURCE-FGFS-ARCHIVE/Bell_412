<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <path>oil_temp.ac</path>

	<!--effect>
		<inherits-from>Effects/model-transparent</inherits-from>
		<condition>
			<property>/sim/rendering/rembrandt/enabled</property>
		</condition>
		<object-name>face</object-name> 
		<object-name>needle</object-name> 
	</effect-->

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <emission>
      <factor-prop>/systems/electrical/outputs/instrument-lights</factor-prop>
            <red>0.0175</red>
            <green>0.0175</green>
            <blue>0.0175</blue>
    </emission>
  </animation>
	
  <animation>
    <type>rotate</type><!-- this is bit of a cheat beause there isn't 
                            an engine-oil-temperature property available -->  
    <object-name>needle</object-name>
    <property>/engines/engine/tot-degc</property>
    <interpolation>
      <entry><ind> -400 </ind><dep>  0 </dep></entry>
      <entry><ind>  0 </ind><dep> 45 </dep></entry>
      <entry><ind>  800 </ind><dep>180 </dep></entry><!-- 60 deg C -->
      <entry><ind> 1600 </ind><dep>225 </dep></entry>
      <entry><ind> 2000 </ind><dep>270 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

	<animation>
		<type>range</type>
		<min-m>0</min-m>
		<max-m>5</max-m>
	</animation>
	
	<model>
		
		<path>Aircraft/bk117-b2/Models/Interior/Instruments/surround/surround.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0.001</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="900">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.5</y-offset>
    <z-offset>0.5</z-offset>
   </animation>
  </overlay>
		</model>	

</PropertyList>

