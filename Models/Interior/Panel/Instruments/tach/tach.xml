<?xml version="1.0"?>

<PropertyList>
	<path>tach.ac</path>
	
	
	
	

	<animation>
		<type>rotate</type>
		<object-name>TurbineNeedle1</object-name>
		<property>engines/engine[0]/n2-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>35</dep></entry>
			<entry><ind>50</ind><dep>151</dep></entry>
			<entry><ind>100</ind><dep>267</dep></entry>
			<entry><ind>140</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>TurbineNeedle2</object-name>
		<property>engines/engine[1]/n2-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>35</dep></entry>
			<entry><ind>50</ind><dep>151</dep></entry>
			<entry><ind>100</ind><dep>267</dep></entry>
			<entry><ind>140</ind><dep>360</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>RotorNeedle</object-name>
		<property>rotors/main/rpm</property>
		<factor>0.7</factor>
		<axis>
			<x>-1</x>
		</axis>
	</animation>
	
	 <animation>
    <type>material</type>
    <object-name>RotorNeedle</object-name>
	<object-name>TurbineNeedle1</object-name>
		<object-name>TurbineNeedle2</object-name>
		<object-name>Face</object-name>
    <object-name>needle</object-name>
  <emission>
			<red>0.28</red>
			<green>0.40</green>
			<blue>0.24</blue>
<factor-prop>controls/lighting/instrument-lights-norm</factor-prop>
		</emission>
  </animation>
	
	
 <model>
		
		<path>Aircraft/Bell_412/Models/Interior/Panel/Instruments/surround/surround.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0.002</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="900">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>1.08</y-offset>
    <z-offset>1.08</z-offset>
   </animation>
  </overlay>
		</model>	
	
</PropertyList>

