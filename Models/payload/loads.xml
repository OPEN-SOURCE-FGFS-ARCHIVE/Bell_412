<?xml version="1.0"?>

<PropertyList>
	
	
<animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>500</max-m>
    </animation>

<model>
		<name>Pylons</name>
		<path>Aircraft/Bell_412/Models/payload/pylons.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
			<pitch-deg>0.0</pitch-deg>
		</offsets>
	</model>	




  <model>
		<name>Basic</name>
		<path>Aircraft/Bell_412/Models/payload/basic.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Basic</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Basic</value>
        </equals>
       
    </condition>
  </animation>		

  <model>
		<name>Passenger</name>
		<path>Aircraft/Bell_412/Models/payload/passenger.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Passenger</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Passenger</value>
        </equals>
       
    </condition>
  </animation>	


  <model>
		<name>sar</name>
		<path>Aircraft/Bell_412/Models/payload/sar.xml</path>
		<offsets>
			<x-m> -0 </x-m>
            <y-m>  0.03387 </y-m>
            <z-m> -0.1 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>sar</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>sar</value>
        </equals>
       
    </condition>
  </animation>

   <model>
		<name>Hems</name>
		<path>Aircraft/Bell_412/Models/payload/hems.xml</path>
		<offsets>
			<x-m> -0 </x-m>
            <y-m>  0.03387 </y-m>
            <z-m> -0.1 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Hems</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Hems</value>
        </equals>
       
    </condition>
  </animation>
  
  

  <model>
		<name>Offshore</name>
		<path>Aircraft/Bell_412/Models/payload/offshore.xml</path>
		<offsets>
			<x-m>0</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>0 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Offshore</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Offshore</value>
        </equals>
       
    </condition>
  </animation>

  
  <animation>
  <type>select</type>
  <object-name>pylon.C</object-name>  
  <condition>
  <or>
  
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Basic</value>
   </equals>
  
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Passenger</value>
   </equals>
   
    <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Hems</value>
   </equals>
   
   
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Offshore</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>sar</value>
   </equals>
   
   
   
  </or>
  </condition>
 </animation>

</PropertyList>
