</key>

<key n="100">
<name>d</name>
<desc>Rotate Spotlight right</desc>
<repeatable>true</repeatable>
<interval-sec>0.001</interval-sec>
<binding>
 <command>property-adjust</command>
<property>sim/multiplay/generic/float[10]</property>
 <step>-1</step>

<max>110</max>
</binding>
</key>

<key n="113">
<name>q</name>
<desc>Rotate Spotlight up</desc>
<repeatable>true</repeatable>
<interval-sec>0.001</interval-sec>
<binding>
 <command>property-adjust</command>
<property>sim/multiplay/generic/float[11]</property>
 <step>-1</step>

 <max>0</max>
</binding>
</key>

<key n="122">
<name>z</name>
<desc>Rotate Spotlight down</desc>
<repeatable>true</repeatable>
<interval-sec>0.001</interval-sec>
<binding>
 <command>property-adjust</command>
 <property>sim/multiplay/generic/float[11]</property>
 <step>1</step>

 <max>0</max>
</binding>
</key>


 

<key n="4">
    <name>Ctrl-d</name>
    <desc>Toggle SAS enabled</desc>
    <binding>
      <command>nasal</command>
      <script>bo105.sas.toggleEnable();</script>
    </binding>
  </key>

<key n="6">
		<name>Ctrl-f</name>
		<desc>Toggle AutoHover</desc>
		<binding>
			<command>nasal</command>
			<script>bo105.afcs.toggleAutoHover();</script>
		</binding>
	</key>
		
		 <key n="15">
      <name>Ctrl-O</name>
      <desc>Auto Attach Cargo</desc>
      <binding>
        <command>property-toggle</command>
        <property>/sim/cargo/cargo-auto-hook</property>
      </binding>
    </key>

		 <key n="79">
      <name>O</name>
      <desc>Attach Cargo</desc>
      <binding>
        <command>property-assign</command>
        <property>sim/cargo/cargo-hook</property>
        <value type="bool">true</value>
      </binding>
    </key>


    <key n="111">
      <name>o</name>
      <desc>Release Cargo</desc>
      <binding>
        <command>property-assign</command>
        <property>controls/cargo-release</property>
        <value type="bool">true</value>
      </binding>
    </key>
		</keyboard>
		
		
		
   
		
		
